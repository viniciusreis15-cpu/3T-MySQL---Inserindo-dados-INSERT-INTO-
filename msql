-- Consultar todos os dados das tabelas
select * from paciente;
select * from medico;
select * from consulta;

-- Consultar duas tabelas com inner join
select paciente.nome, consulta.data_time
from paciente
inner join consulta
on paciente.id = consulta.id_paciente;

-- Consultar as três tabelas juntas
select paciente.nome as paciente, medico.nome as medico, consulta.data_time
from consulta
inner join paciente on consulta.id_paciente = paciente.id
inner join medico   on consulta.id_medico   = medico.id;
