-- Tabela consulta
create table if not exists consulta (
	id int primary key auto_increment,
    data_time datetime,
    id_paciente int,
    id_medico int,
    foreign key (id_paciente) references paciente(id),
    foreign key (id_medico) references medico(id)
) character set utf8mb4;

